<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="croissantage_event_view_form" model="ir.ui.view">
        <field name="name">croissant.view.form</field>
        <field name="model">croissantage.event</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': 1}"/>
                    <button string="Validate" name="act_validate" type="object" invisible="state == 'done'" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Unexpected croissantage"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="croissanted_id" domain="[('is_company','=', False)]"/>
                            <field name="city"/>
                            <field name="croissanter_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="duration"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="croissantage_event_view_list" model="ir.ui.view">
        <field name="name">croissantage.event.view.list</field>
        <field name="model">croissantage.event</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="croissanted_id"/>
                <field name="croissanter_ids" widget="many2many_tags" optional="hide"/>
                <field name="state" optional="show"/>
            </list>
        </field>
    </record>

    <record id="croissantage_event_action" model="ir.actions.act_window">
        <field name="name">Croissantages</field>
        <field name="res_model">croissantage.event</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="croissantage_menu"
        name="Croissantage"
        action="croissantage_event_action"
        web_icon="croissantage,static/description/icon.png"
    />
</odoo>
