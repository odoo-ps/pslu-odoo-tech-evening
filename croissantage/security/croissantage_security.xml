<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- groups and privileges -->
    <record id="res_groups_privilege_croissantage" model="res.groups.privilege">
        <field name="name">Croissantage</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="base.module_category_human_resources_lunch"/>
    </record>

    <record id="group_croissantage_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">User can view all croissantages but manage only his own</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_croissantage"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <!-- <field name="user_ids" eval="[Command.link(ref('base.user_demo'))]"/> -->
    </record>
    <record id="group_croissantage_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Administrator can manage any croissantage</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_croissantage"/>
        <field name="implied_ids" eval="[Command.link(ref('croissantage.group_croissantage_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>

    <!-- record rules -->
    <record id="create_own_croissantage_rule" model="ir.rule">
        <field name="name">Create own croissantages</field>
        <field name="model_id" ref="model_croissantage_event"/>
        <field name="domain_force">[('croissanter_ids', 'in', [user.partner_id.id])]</field>
        <field name="groups" eval="[Command.link(ref('croissantage.group_croissantage_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="modify_own_unpaid_croissantage_rule" model="ir.rule">
        <field name="name">Modify own and unpaid croissantages</field>
        <field name="model_id" ref="model_croissantage_event"/>
        <field name="domain_force">[('create_uid', '=', user.id), ('state', '!=', 'done')]</field>
        <field name="groups" eval="[Command.link(ref('croissantage.group_croissantage_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="full_access_croissantage_rule" model="ir.rule">
        <field name="name">Modify own and unpaid croissantages</field>
        <field name="model_id" ref="model_croissantage_event"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('croissantage.group_croissantage_manager'))]"/>
    </record>
</odoo>
